---
import Layout from '~/layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import CustomStyles from '~/components/CustomStyles.astro';
import { Image } from 'astro:assets';
import logoHeader from '~/assets/images/ootb-logo-header.svg';

interface Tool {
  title: string;
  /** Ce que l'outil permet de faire, en une phrase. */
  purpose: string;
  url: string;
  icon: string;
  /** Qui se connecte (email affiché en monospace). */
  login?: string;
  note?: string;
  essential?: boolean;
}

const contactInfo = {
  email: 'hello@pwablo.be',
  phone: '0494 87 89 36',
  phoneTel: '+32494878936',
  whatsapp: 'https://wa.me/32494878936',
  github: 'https://github.com/ggustin93/ootb',
};

const umamiUrl = 'https://cloud.umami.is/share/VJBTDMq2NAlUVkDO/outofthebooks.netlify.app';

const notionUrl = 'https://pwablo-be.notion.site/Out-of-the-books-ASBL-FAQ-1b995a27d85380809142f0e1a369d9cc?pvs=4';

const contentTools: Tool[] = [
  {
    title: 'Éditeur de pages (TinaCMS)',
    purpose:
      'Textes, images et menus des pages : accueil, festival, à propos, contact, articles, Erasmus+, mentions légales.',
    url: '/admin',
    icon: 'tabler:edit',
    login: 'alexia@festivaloutofthebooks.com',
    note: 'Accès sur invitation',
    essential: true,
  },
  {
    title: 'Base de données (NocoDB)',
    purpose:
      'Programme du festival (ateliers, conférences, stands), fiches pédagogiques, messages reçus par les formulaires.',
    url: import.meta.env.NOCODB_BASE_URL || 'https://app.nocodb.com',
    icon: 'tabler:database',
    login: "Toute l'équipe",
    note: 'Connexion par email',
    essential: true,
  },
];

const tasks: { want: string; where: 'tina' | 'nocodb' }[] = [
  { want: "Modifier un texte ou une image d'une page", where: 'tina' },
  { want: 'Écrire ou corriger un article', where: 'tina' },
  { want: 'Changer le menu ou les liens du pied de page', where: 'tina' },
  { want: 'Modifier le programme du festival', where: 'nocodb' },
  { want: 'Publier ou retirer une fiche pédagogique', where: 'nocodb' },
  { want: 'Lire les messages de contact, les inscrits newsletter, les fiches proposées', where: 'nocodb' },
];
const toolLabel = { tina: 'Éditeur de pages (TinaCMS)', nocodb: 'Base de données (NocoDB)' };

const hostingTools: Tool[] = [
  {
    title: 'OVH',
    purpose: 'Nom de domaine et adresses email.',
    url: 'https://www.ovh.com/manager/',
    icon: 'tabler:world',
    login: '3121-0412-77/guillaume',
    note: 'Compte auxiliaire (DNS et emails)',
  },
  {
    title: 'Netlify',
    purpose: 'Hébergement du site et mises à jour (déploiements).',
    url: 'https://app.netlify.com/',
    icon: 'tabler:cloud',
    login: 'guillaume.gustin.9@gmail.com',
    note: 'Accès ou transfert sur demande',
  },
  {
    title: 'Cloudinary',
    purpose: 'Stockage et optimisation des images.',
    url: 'https://cloudinary.com/console/',
    icon: 'tabler:photo',
    login: 'hello@pwablo.be',
    note: 'Accès ou transfert sur demande',
  },
];

const sections = [
  { id: 'contenu', label: 'Modifier le site', icon: 'tabler:edit-circle' },
  { id: 'analytics', label: 'Statistiques', icon: 'tabler:chart-dots' },
  { id: 'hebergement', label: 'Hébergement et comptes', icon: 'tabler:server' },
  { id: 'aide', label: 'Aide', icon: 'tabler:help-circle' },
  { id: 'eco', label: 'Éco-responsabilité', icon: 'tabler:leaf' },
  { id: 'code', label: 'Code source', icon: 'tabler:brand-github' },
];

const newTab = '(s’ouvre dans un nouvel onglet)';
---

<Layout metadata={{ title: 'Tableau de bord - Out of the Books', robots: { index: false, follow: false } }}>
  <!-- Accès protégé côté serveur (netlify/edge-functions/portal-auth.ts) -->
  <CustomStyles />
  <div class="flex flex-col md:flex-row h-screen bg-gray-50">
    <aside
      id="sidebar"
      class="md:w-64 bg-white border-r border-gray-200 overflow-y-auto flex flex-col fixed inset-y-0 left-0 z-30 transform md:relative md:translate-x-0 transition duration-300 ease-in-out w-64 -translate-x-full"
    >
      <div class="p-4 border-b border-gray-200 flex justify-between items-center">
        <Image src={logoHeader} alt="Out of the Books" class="h-8 w-auto" />
        <button id="close-sidebar" class="md:hidden text-gray-600 hover:text-gray-900" aria-label="Fermer le menu">
          <Icon name="tabler:x" class="w-6 h-6" />
        </button>
      </div>

      <nav class="flex-1 p-4 space-y-1" aria-label="Sections du tableau de bord">
        {
          sections.map((s) => (
            <a
              href={`#${s.id}`}
              class="flex items-center px-3 py-2 text-sm text-gray-700 rounded-lg hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-[var(--ootb-blue)]"
            >
              <Icon name={s.icon} class="w-5 h-5 mr-3 text-gray-500" />
              {s.label}
            </a>
          ))
        }
      </nav>

      <div class="p-4 bg-gray-50 border-t border-gray-200" aria-label="Contact">
        <p class="text-xs text-gray-600 mb-2">Besoin d'aide ?</p>
        <div class="flex flex-col space-y-2 text-sm">
          <a
            href={`mailto:${contactInfo.email}`}
            class="flex items-center px-3 py-2 text-gray-700 rounded-lg bg-white hover:bg-gray-100"
          >
            <Icon name="tabler:mail" class="w-5 h-5 mr-3 text-gray-500" />
            {contactInfo.email}
          </a>
          <a
            href={`tel:${contactInfo.phoneTel}`}
            class="flex items-center px-3 py-2 text-gray-700 rounded-lg bg-white hover:bg-gray-100"
          >
            <Icon name="tabler:phone" class="w-5 h-5 mr-3 text-gray-500" />
            {contactInfo.phone}
          </a>
          <a
            href={contactInfo.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center px-3 py-2 text-gray-700 rounded-lg bg-white hover:bg-gray-100"
          >
            <Icon name="tabler:brand-whatsapp" class="w-5 h-5 mr-3 text-gray-500" />
            WhatsApp
            <span class="sr-only">{newTab}</span>
          </a>
        </div>
      </div>
    </aside>

    <div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-20 hidden md:hidden"></div>

    <main class="flex-1 overflow-y-auto">
      <div class="sticky top-0 z-10 md:hidden bg-white border-b border-gray-200 shadow-sm">
        <div class="flex items-center justify-between p-4">
          <Image src={logoHeader} alt="Out of the Books" class="h-8 w-auto" />
          <button id="open-sidebar" class="text-gray-600 hover:text-gray-900" aria-label="Ouvrir le menu">
            <Icon name="tabler:menu-2" class="w-6 h-6" />
          </button>
        </div>
      </div>

      <div class="max-w-4xl mx-auto p-4 md:p-8">
        <h1 class="dashboard-title font-handwritten font-bold text-[var(--ootb-blue)] mb-2">Tableau de bord</h1>
        <p class="text-gray-600 mb-8">Tous les outils pour gérer le site d'Out of the Books.</p>

        {/* Modifier le site */}
        <details id="contenu" class="group/acc mb-8">
          <summary class="acc-summary">
            <Icon name="tabler:edit-circle" class="w-6 h-6 text-[var(--ootb-orange)]" />
            <h2 class="acc-title">Modifier le site</h2>
            <Icon name="tabler:chevron-down" class="acc-chevron group-open/acc:rotate-180" />
          </summary>
          <p class="acc-intro">
            Deux outils : l'un pour les textes des pages, l'autre pour le programme et les fiches.
          </p>

          <div class="grid gap-4 md:grid-cols-2 mb-6">
            {
              contentTools.map((tool) => (
                <a
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tool-card flex flex-col gap-2 p-4 bg-white rounded-xl border border-gray-200 hover:border-[var(--ootb-blue)] hover:shadow-md transition-all duration-200"
                >
                  <div class="flex items-center gap-2">
                    <Icon name={tool.icon} class="w-5 h-5 text-[var(--ootb-blue)]" />
                    <h3 class="tool-title">{tool.title}</h3>
                    <Icon name="tabler:external-link" class="w-4 h-4 text-gray-500" />
                    <span class="sr-only">{newTab}</span>
                  </div>
                  <p class="text-sm text-gray-700">{tool.purpose}</p>
                  <p class="text-xs text-gray-600 mt-auto">
                    <span class={tool.login?.includes('@') ? 'font-mono' : 'font-medium'}>{tool.login}</span>
                    {tool.note && ` · ${tool.note}`}
                  </p>
                </a>
              ))
            }
          </div>

          <table class="w-full text-sm bg-white rounded-xl border border-gray-200 overflow-hidden mb-4">
            <caption class="sr-only">Quel outil utiliser selon ce que vous voulez faire</caption>
            <thead class="bg-gray-50 text-left text-gray-700">
              <tr>
                <th scope="col" class="px-4 py-2 font-semibold">Je veux…</th>
                <th scope="col" class="px-4 py-2 font-semibold">Allez dans…</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {
                tasks.map((t) => (
                  <tr>
                    <td class="px-4 py-2 text-gray-800">{t.want}</td>
                    <td class="px-4 py-2 text-gray-700 whitespace-nowrap">{toolLabel[t.where]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <div role="note" class="flex gap-3 p-4 rounded-xl bg-amber-50 text-amber-900 text-sm">
            <Icon name="tabler:info-circle" class="w-5 h-5 flex-shrink-0 mt-0.5" />
            <div>
              <p>
                <strong>Bon à savoir :</strong> les changements faits dans la base de données (NocoDB) n'apparaissent pas
                tout de suite sur le site. Pour les publier, cliquez sur <strong>« Redéployer le site web »</strong> dans
                NocoDB (table « Actions spéciales ») : le site est à jour quelques minutes plus tard. Les changements faits
                dans l'éditeur de pages (TinaCMS) se publient seuls.
              </p>
              <a
                href={contentTools[1].url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 mt-2 font-semibold underline hover:no-underline"
              >
                Ouvrir NocoDB
                <Icon name="tabler:external-link" class="w-4 h-4" />
                <span class="sr-only">{newTab}</span>
              </a>
            </div>
          </div>
        </details>

        {/* Statistiques */}
        <details id="analytics" class="group/acc mb-8">
          <summary class="acc-summary">
            <Icon name="tabler:chart-dots" class="w-6 h-6 text-[var(--ootb-green)]" />
            <h2 class="acc-title">Statistiques</h2>
            <Icon name="tabler:chevron-down" class="acc-chevron group-open/acc:rotate-180" />
          </summary>
          <p class="acc-intro">Combien de personnes visitent le site, et quelles pages (Umami).</p>
          <iframe
            src={umamiUrl}
            loading="lazy"
            title="Statistiques de visite du site (Umami)"
            class="w-full h-[480px] md:h-[640px] rounded-xl border border-gray-200 bg-white"></iframe>
          <div class="flex flex-wrap justify-between gap-2 mt-2 text-xs text-gray-600">
            <span>Rien ne s'affiche ? Utilisez le lien.</span>
            <a
              href={umamiUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--ootb-blue)] underline hover:no-underline"
            >
              Ouvrir dans un nouvel onglet
              <Icon name="tabler:external-link" class="w-4 h-4" />
            </a>
          </div>
          <p class="text-xs text-gray-600 mt-1">
            Compte admin Umami : hello@pwablo.be (accès ou transfert sur demande).
          </p>
        </details>

        {/* Hébergement et comptes */}
        <details id="hebergement" class="group/acc mb-8">
          <summary class="acc-summary">
            <Icon name="tabler:server" class="w-6 h-6 text-[var(--ootb-blue)]" />
            <h2 class="acc-title">Hébergement et comptes</h2>
            <Icon name="tabler:chevron-down" class="acc-chevron group-open/acc:rotate-180" />
          </summary>
          <p class="acc-intro">Nom de domaine, hébergement et images. Rarement utile au quotidien.</p>
          <div class="grid gap-3">
            {
              hostingTools.map((tool) => (
                <a
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-3 p-4 bg-white rounded-xl border border-gray-200 hover:border-[var(--ootb-blue)] transition-colors"
                >
                  <Icon name={tool.icon} class="w-5 h-5 mt-0.5 text-gray-500" />
                  <div class="min-w-0">
                    <h3 class="tool-title inline-flex items-center gap-1">
                      {tool.title}
                      <Icon name="tabler:external-link" class="w-4 h-4 text-gray-500" />
                      <span class="sr-only">{newTab}</span>
                    </h3>
                    <p class="text-sm text-gray-700">{tool.purpose}</p>
                    <p class="text-xs text-gray-600">
                      <span class="font-mono">{tool.login}</span> · {tool.note}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </details>

        {/* Aide */}
        <details id="aide" class="group/acc mb-8">
          <summary class="acc-summary">
            <Icon name="tabler:help-circle" class="w-6 h-6 text-[var(--ootb-violet)]" />
            <h2 class="acc-title">Aide</h2>
            <Icon name="tabler:chevron-down" class="acc-chevron group-open/acc:rotate-180" />
          </summary>
          <p class="acc-intro">Documentation et contact.</p>
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 p-4 bg-white rounded-xl border border-gray-200">
            <p class="text-sm text-gray-700 flex-1">
              Guides pas à pas et réponses aux questions fréquentes. Pour le reste : {contactInfo.email} ou
              {contactInfo.phone}.
            </p>
            <a
              href={notionUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-4 py-2 bg-[var(--ootb-blue)] text-white text-sm font-semibold rounded-lg hover:opacity-90 self-start"
            >
              <Icon name="tabler:brand-notion" class="w-5 h-5 mr-2" />
              Voir la FAQ
              <span class="sr-only">{newTab}</span>
            </a>
          </div>
        </details>

        {/* Éco-responsabilité */}
        <details id="eco" class="group/acc mb-8">
          <summary class="acc-summary">
            <Icon name="tabler:leaf" class="w-6 h-6 text-[var(--ootb-green)]" />
            <h2 class="acc-title">Éco-responsabilité</h2>
            <Icon name="tabler:chevron-down" class="acc-chevron group-open/acc:rotate-180" />
          </summary>
          <p class="acc-intro">Un site sobre, pensé pour consommer peu, et comment le garder ainsi.</p>

          {/* Mesure du 23/10/2026 (CO2.js, modèle SWD v4, celui de Website Carbon) — à rafraîchir de temps en temps */}
          <div class="flex flex-col sm:flex-row gap-4 p-4 mb-4 bg-white rounded-xl border border-gray-200">
            <div
              class="flex-shrink-0 self-start w-16 h-16 rounded-xl bg-green-700 text-white flex items-center justify-center text-3xl font-bold"
              aria-hidden="true"
            >
              A
            </div>
            <div class="text-sm text-gray-700">
              <p class="tool-title">Note A pour l'empreinte carbone (méthode Website Carbon)</p>
              <p>
                Environ <strong>0,06 g de CO₂ par visite</strong> de la page d'accueil. Elle pèse 377 Ko, plus de cinq fois
                moins qu'une page web moyenne (environ 2 Mo).
              </p>
              <p class="text-xs text-gray-600 mt-1">
                Mesuré le 23 octobre 2026. Le site est généré à l'avance (Astro) et les images sont optimisées
                automatiquement (Cloudinary).
              </p>
            </div>
          </div>

          <h3 class="tool-title mb-2">Pourquoi c'est important</h3>
          <ul class="text-sm text-gray-700 space-y-2 mb-4">
            <li class="flex gap-2">
              <Icon name="tabler:bolt" class="w-4 h-4 mt-0.5 flex-shrink-0 text-[var(--ootb-green)]" />
              Pour vos visiteurs : le site s'ouvre vite, même sur un vieux téléphone ou une connexion faible.
            </li>
            <li class="flex gap-2">
              <Icon name="tabler:search" class="w-4 h-4 mt-0.5 flex-shrink-0 text-[var(--ootb-green)]" />
              Pour Google : un site rapide est mieux classé dans les résultats de recherche.
            </li>
            <li class="flex gap-2">
              <Icon name="tabler:leaf" class="w-4 h-4 mt-0.5 flex-shrink-0 text-[var(--ootb-green)]" />
              Pour la planète : moins de données transférées, donc moins d'énergie, en cohérence avec vos valeurs.
            </li>
          </ul>

          <h3 class="tool-title mb-2">Ce que vous pouvez faire</h3>
          <ul class="text-sm text-gray-700 space-y-2 mb-4">
            <li class="flex gap-2">
              <Icon name="tabler:check" class="w-4 h-4 mt-0.5 flex-shrink-0 text-[var(--ootb-green)]" />
              Redimensionner les images avant de les ajouter (1200 px de large maximum).
            </li>
            <li class="flex gap-2">
              <Icon name="tabler:check" class="w-4 h-4 mt-0.5 flex-shrink-0 text-[var(--ootb-green)]" />
              Les compresser : le site charge plus vite et consomme moins.
            </li>
            <li class="flex gap-2">
              <Icon name="tabler:check" class="w-4 h-4 mt-0.5 flex-shrink-0 text-[var(--ootb-green)]" />
              Préférer les formats modernes (WebP, AVIF) quand c'est possible.
            </li>
          </ul>
          <div class="flex flex-wrap gap-3 text-sm">
            <a
              href="https://squoosh.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-2 bg-white border border-gray-200 rounded-lg hover:bg-gray-100"
              >Squoosh (compression)<span class="sr-only">{newTab}</span></a
            >
            <a
              href="https://www.iloveimg.com/resize-image"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-2 bg-white border border-gray-200 rounded-lg hover:bg-gray-100"
              >iLoveIMG (redimensionnement)<span class="sr-only">{newTab}</span></a
            >
          </div>
        </details>

        {/* Code source */}
        <details id="code" class="group/acc mb-8">
          <summary class="acc-summary">
            <Icon name="tabler:brand-github" class="w-6 h-6 text-gray-800" />
            <h2 class="acc-title">Code source</h2>
            <Icon name="tabler:chevron-down" class="acc-chevron group-open/acc:rotate-180" />
          </summary>
          <p class="acc-intro">Le code du site, si un autre développeur reprend.</p>
          <p class="text-sm text-gray-700 mb-4">
            Site Astro + TinaCMS, documenté pour être repris facilement. Le développeur initial (pwablo) reste
            disponible pour toute évolution.
          </p>
          <a
            href={contactInfo.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-4 py-2 bg-gray-800 text-white text-sm font-semibold rounded-lg hover:opacity-90"
          >
            <Icon name="tabler:brand-github" class="w-5 h-5 mr-2" />
            Voir le code sur GitHub
            <span class="sr-only">{newTab}</span>
          </a>
        </details>
      </div>
    </main>
  </div>
</Layout>

<style>
  /* Hiérarchie : h1 (30→36px) > h2 sections (18→20px) > h3 outils (16px).
     Neutralise localement les règles globales h1/h3 du site public (CustomStyles). */
  .dashboard-title {
    font-size: 1.875rem;
    letter-spacing: normal;
  }

  @media (min-width: 768px) {
    .dashboard-title {
      font-size: 2.25rem;
    }
  }

  .tool-title {
    font-family: inherit;
    font-variation-settings: normal;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1.5;
    color: rgb(17 24 39);
  }

  .acc-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    margin-bottom: 0.75rem;
    cursor: pointer;
    list-style: none;
    border-radius: 0.5rem;
  }

  .acc-summary::-webkit-details-marker {
    display: none;
  }

  .acc-summary:focus-visible {
    outline: 2px solid var(--ootb-blue);
    outline-offset: 4px;
  }

  .acc-title {
    flex: 1;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: normal;
    color: rgb(17 24 39);
  }

  @media (min-width: 768px) {
    .acc-title {
      font-size: 1.25rem;
    }
  }

  .acc-chevron {
    width: 1.25rem;
    height: 1.25rem;
    color: rgb(107 114 128);
    transition: transform 0.2s ease;
  }

  .acc-intro {
    font-size: 0.875rem;
    color: rgb(75 85 99);
    margin-bottom: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-chevron,
    #sidebar {
      transition: none;
    }
  }
</style>

<script>
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');

  function setSidebar(open: boolean): void {
    sidebar?.classList.toggle('-translate-x-full', !open);
    overlay?.classList.toggle('hidden', !open);
    document.body.classList.toggle('overflow-hidden', open);
  }

  document.getElementById('open-sidebar')?.addEventListener('click', () => setSidebar(true));
  document.getElementById('close-sidebar')?.addEventListener('click', () => setSidebar(false));
  overlay?.addEventListener('click', () => setSidebar(false));

  // Un lien du menu ouvre la section visée (et referme le menu sur mobile)
  sidebar?.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => {
      const target = document.getElementById(link.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
      if (window.innerWidth < 768) setSidebar(false);
    });
  });
</script>
